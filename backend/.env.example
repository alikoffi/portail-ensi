# =====================================================================
# Modele de configuration. Copier en .env (jamais committe) et renseigner.
# =====================================================================

# Base de donnees (URL JDBC complete ; en prod inclure ?sslmode=require)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/portail_ensi
SPRING_DATASOURCE_USERNAME=portail_ensi
SPRING_DATASOURCE_PASSWORD=changeme

# Securite JWT (chaine aleatoire >= 32 caracteres)
JWT_SECRET=changeme-secret-jwt

# Email
# Fournisseur : smtp (local) ou brevo (prod sur Render qui bloque le SMTP sortant)
MAIL_PROVIDER=smtp
MAIL_ENABLED=true
MAIL_FROM=adresse@gmail.com
MAIL_FROM_NAME=Portail ENSI
# --- SMTP (si MAIL_PROVIDER=smtp) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=adresse@gmail.com
MAIL_PASSWORD=mot-de-passe-application
# --- Brevo (si MAIL_PROVIDER=brevo) ---
BREVO_API_KEY=xkeysib-...

# Documents televerses
# Fournisseur : local (disque, developpement) ou b2 (Backblaze B2, production)
STORAGE_PROVIDER=local
# Laisser vide pour le defaut : <dossier utilisateur>/portail-ensi/documents
#STORAGE_BASE_DIR=
# --- Backblaze B2 (si STORAGE_PROVIDER=b2) ---
# L'endpoint et la region vont de pair : s3.<region>.backblazeb2.com
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_BUCKET=portail-ensi-documents
B2_ACCESS_KEY=
B2_SECRET_KEY=
B2_REGION=us-west-004

# URLs (mises a jour en production)
APP_BASE_URL=http://localhost:4200
CLIENT_URL=http://localhost:4200
