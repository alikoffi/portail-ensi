# =====================================================================
# Modele de configuration locale. Copier en .env et renseigner les valeurs.
# Le fichier .env n'est jamais committe (secrets).
# =====================================================================

# Base de donnees
DB_HOST=localhost
DB_PORT=5432
DB_NAME=portail_ensi
DB_USER=portail_ensi
DB_PASSWORD=changeme

# Securite JWT (chaine aleatoire >= 32 caracteres)
JWT_SECRET=changeme-secret-jwt

# Email (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=adresse@gmail.com
MAIL_PASSWORD=mot-de-passe-application
MAIL_FROM=adresse@gmail.com
MAIL_ENABLED=true

# URLs (mises a jour en production)
APP_BASE_URL=http://localhost:4200
CLIENT_URL=http://localhost:4200
